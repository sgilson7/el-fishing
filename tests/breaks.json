    "replace": "                self.world.step(k & !bits::SCOPE);\n                self.world.arms.slow = k & bits::SCOPE != 0;",
    "test": "the_scope_changes_no_rule"
  },
  {
    "name": "a fish's weight grows as the cube of its length",
    "file": "crates/core/src/fish.rs",
    "find": "fx::mul(spec.grams_at_shortest * ONE / 1000, fx::mul(r, fx::mul(r, r)))",
    "replace": "fx::mul(spec.grams_at_shortest * ONE / 1000, fx::mul(r, r))",
    "test": "weight_grows_as_the_cube_of_length"
  },
  {
